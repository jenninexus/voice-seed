# Optional. Only needed if you run the spoken-voice tooling (docs/SPOKEN-VOICE.md). Copy to .env.

# VoiceStudio backend (HTTP API + MCP at /mcp), bound to 127.0.0.1 on the machine that runs it.
# Pick anything but 3900 (VoiceStudio's stock default) if you also use the VoiceStudio desktop app.
VOICESTUDIO_PORT=3901

# Local port for an ssh tunnel to that backend when it runs on another machine.
VOICESTUDIO_TUNNEL_PORT=3902

# Optional: Syqo URL that resolves VOICESTUDIO_JOB to a machine (studio network only).
# VOICESTUDIO_JOB=heavy
# SYQO_URL=http://localhost:9999
