  "_meta": {
    "description": "Writing-register map. Deep content lives in owning repos; this file is the index.",
    "updated": "2026-09-03",
    "docs": {
      "registers": "docs/REGISTERS.md",
      "protocol": "docs/PROTOCOL.md",
      "roadmap": "docs/ROADMAP.md",
      "overview": "docs/OVERVIEW.md",
      "publicLocalSplit": "docs/PUBLIC-LOCAL-SPLIT.md",
      "product": "docs/PRODUCT.md"
    }
  },
  "registers": {
    "application": {
      "purpose": "Resume + cover letter prose",
      "ssotPattern": "pdf-designer/storage/<user>/resume-source.json#voice"
    },
    "character": {
      "purpose": "Personality, partner contrast, emoji prefs, register pointers",
      "ssotPattern": "pdf-designer/storage/users/<user>.json#characterVoice"
    },
    "mission": {
      "purpose": "Owner mission / research spine (optional)",
      "ssotPattern": "pdf-designer/storage/<user>/resume-source.json#mission"
    },
    "studioResume": {
      "purpose": "Studio capability or games applications",
      "ssotPattern": "pdf-designer/storage/profiles/{studio-resume|martian-resume}.json#voice"
    },
    "socialMarketing": {
      "purpose": "Patreon / Discord / news brand posts",
      "ssotPattern": "socials/content/<brand>/format-manifest.json"
    },
    "botGreeter": {
      "purpose": "Join-welcome embed prose (app bot user)",
      "ssotPattern": "{bot}/content/greeting.md"
    },
    "discordVisual": {
      "purpose": "Embed chrome, custom emoji IDs, layout — not join prose",
      "ssotPattern": "{bot}/docs/STYLE-SPEC.md + resources/assets.json"
    },
    "agencyAudit": {
      "purpose": "Site-QA character personality",
      "ssotPattern": "agency/agents/<Name>.md"
    },
    "agencyStudioShared": {
      "purpose": "Shared loft attributes for all agency agents",
      "ssotPattern": "agency/docs/STUDIO-VOICE.md"
    },
    "agencyDiscordChat": {
      "purpose": "Discord agency-channel posters",
      "ssotPattern": "{bot}/resources/agency-profiles.json + agent chatVoice"
    },
    "gameSecurityChat": {
      "purpose": "Player-facing game security / triage Discord voice",
      "ssotPattern": "Tank Off/Docs/Security/Gub_MG-Security_/Gub-Persona.md"
    },
    "signalTone": {
      "purpose": "NEOPHI Signal Crew in-character speaking tone",
      "ssotPattern": "characters/neophi/<id>.md",
      "canon": "neophi/src/assets/data/characters.md",
      "notThese": ["applicant voice", "studio we", "Agency loft chatVoice", "bot greeter"]
    }
  },
