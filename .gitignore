# Secrets / machine-local
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
**/userdata.db

# Local-only working state. Public roadmap = docs/ROADMAP.md.
# Session plans are studio work notes, not part of the clone (see docs/PUBLIC-LOCAL-SPLIT.md).
Plans/
# Retired session log — do not recreate at the repo root.
dev-log-sego.yaml
dev-log-*.yaml

# Agent runtimes: ONE tracked command lives in .claude/commands/. Codex/Grok/Cursor read AGENTS.md,
# which points there. Per-machine generated wrappers never get committed.
.codex/
.agents/
.claude/settings.local.json

# Localized command/doc overlays (tracked .md stays shareable)
*.local.md
**/*.local.md
*.local.json
**/*.local.json

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.code-workspace
.cursor/

# The ONE local-private folder (studio overlay, consumer audit, archives). Visible on disk, never pushed.
private/
# Never mirror private vaults, contacts, or exports into this repo
storage/
notes/

# Studio-only operator cards — Handshake / investor / collab never on GitHub
**/*handshake*
**/*-investor*
**/*-collab*
*.pdf
*.png
*.jpg
*.jpeg
*.webp
*.gif

# Generated / deps (if added later)
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
*.log
logs/
